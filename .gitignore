# Gradle / IDE
build/
.gradle/
.kotlin/
local.properties
.idea/
*.iml
.DS_Store

# Model weights and images are never committed; tests read them from the device
*.litertlm
*.tflite
*.bin
*.png
*.jpg
# Except the pong sample's reference frames (six PNGs, 6 KB): its JVM tests compare the app's drawing and resize against them
!samples/pong/src/test/resources/fixtures/*.png
# And the ask sample's reference charts (three PNGs, 2.5 KB): its JVM tests compare the app's drawing against them
!samples/ask/src/test/resources/fixtures/*.png
# And the zipformer front-end references (three float32 files, 94 KB): the zoo app's mel bank and povey window, and a torchaudio fbank
!litert/src/test/resources/zipformer/*.bin

# Build outputs
*.apk
*.aab
*.aar

# Local Maven staging used by the E1 harness (published by ./gradlew publishAllPublicationsToLocalRepository)
local-maven/

# Gate scratch: per-entry gradle output and the unfiltered logcat captures (megabytes); the filtered .log files are the record
litertlm/results/_*
litertlm/results/*.full.log

# Typed-decisions gate scratch, same rule as litertlm/results
litert/results/_*

# Scoring probe: the branch's Kotlin sources and the JNI/LiteRT libraries are synced in, never committed
probes/scoring/jniLibs/
probes/scoring/src/main/kotlin/com/google/

# Qualcomm NPU runtime (LiteRT release + QAIRT): may ship only inside an application, never in this repository.
# tools/fetch_npu_libs.sh puts it into these jniLibs dirs for the device test and the decide sample.
litert/src/androidTest/jniLibs/
samples/decide/src/main/jniLibs/
*.so
