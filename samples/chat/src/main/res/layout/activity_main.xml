<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:fitsSystemWindows="true">

    <EditText android:id="@+id/model_id" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="owner/repo on Hugging Face" android:inputType="textUri" android:text="litert-community/Qwen2.5-1.5B-Instruct" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <RadioGroup android:id="@+id/backend" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/auto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auto" android:checked="true" />
            <RadioButton android:id="@+id/cpu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CPU" />
            <RadioButton android:id="@+id/gpu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GPU" />
        </RadioGroup>
        <Button android:id="@+id/load" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Load" />
        <Button android:id="@+id/release" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Release" android:enabled="false" />
    </LinearLayout>

    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Enter an id and press Load." android:textSize="12sp" />

    <ScrollView android:id="@+id/transcript_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:id="@+id/transcript" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true" />
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/image" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Image" android:enabled="false" />
        <EditText android:id="@+id/prompt" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="Message" android:inputType="textCapSentences|textMultiLine" />
        <Button android:id="@+id/send" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Send" android:enabled="false" />
        <Button android:id="@+id/stop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stop" android:enabled="false" />
    </LinearLayout>
</LinearLayout>
