<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The microphone (granted at run time). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- PhoneTools: the alarm and the timer through the Clock app, events in the app's own "Phone Agent" calendar
         (READ_CALENDAR / WRITE_CALENDAR granted at run time). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- singleTop: `adb shell am start` with new extras reaches the running screen (onNewIntent). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
